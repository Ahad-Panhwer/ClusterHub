{
  "name": "clusterhub-backend",
  "version": "1.0.0",
  "description": "ClusterHub Gaming Tournament & Match Management System — Express REST API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "seed:mongo": "tsx src/scripts/seedMongo.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit"
  },
  "dependencies": {
