# Backend Environment Variables — ClusterHub Express API
# Copy this file to .env.local and fill in real values.
# NEVER commit the actual .env or .env.local file.

# ─── Server & CORS ───
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# ─── MongoDB Atlas (Primary Database) ───
# Get this from MongoDB Atlas: Database > Connect > Drivers > Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/clusterhub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clusterhub?retryWrites=true&w=majority

# ─── Supabase (Optional Legacy Fallback) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
