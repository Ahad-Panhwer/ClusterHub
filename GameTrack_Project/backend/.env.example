# Backend .env — ClusterHub Express API
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Supabase ---
# Project URL from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon (public) key — safe to use server-side for RLS-enforced queries
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Service-role key — NEVER expose in frontend. Only set if needed for admin operations.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# JWT secret for verifying Supabase access tokens (from Project Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
