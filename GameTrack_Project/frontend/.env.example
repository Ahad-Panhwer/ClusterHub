# ClusterHub Frontend Environment
# Copy this to .env.local and fill in real values.
# NEVER commit a .env file with real secrets.

# Base URL for the ClusterHub Express REST API backend
# Development (standalone backend on port 4000):
VITE_API_BASE_URL=http://localhost:4000/api

# Production (replace with your Render URL):
# VITE_API_BASE_URL=https://clusterhub-api.onrender.com/api

# Supabase (only if using Supabase Auth on the frontend — optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
