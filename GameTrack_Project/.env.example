# Frontend (Vite) — public URL only, not a secret
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Backend
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Supabase project configuration — server-side only
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IF_REQUIRED_ON_SERVER
DATABASE_URL=YOUR_POSTGRES_CONNECTION_STRING

# Important:
# - Never place SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL in frontend variables.
# - Prefer a least-privilege backend connection and follow Supabase's current
#   connection guidance for your selected hosting environment.
# - Do not commit a real .env file.
